MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=petlibro_local_backend

# Limit Go compiler concurrency during local image builds.
GO_BUILD_PROCS=2

DEVICE_DISCOVERY=1
PRODUCT_FILTER=PLAF203
LAN_CIDR=192.168.1.0/24
IP_RESOLVE_TIMEOUT_SECONDS=10
IP_REFRESH_INTERVAL_MINUTES=360
IP_RETRY_BACKOFF_SECONDS=60
DEVICES_JSON=[]

GO2RTC_STREAM_NAME=petlibro_feeder
CAMERA_QUALITY=hd
ACK_MODE=hybrid
SEND_DELAY_CTRL=1
HD_PROBE_WAIT_MS=15000

GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555

PUBLISH_CAMERA_METADATA=1
CAMERA_METADATA_TOPIC_PREFIX=
CAMERA_METADATA_INTERVAL_SECONDS=30

VERBOSE_LOGS=0
ENABLE_DEBUG_DUMPS=0
